{
  "expo": {
    "name": "Orvian",
    "slug": "orvian",
    "version": "1.8.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orvian",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegoseg.orvian",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.diegoseg.orvian",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-sharing",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fc3bb73-ece8-45de-8e66-3c5334f5ed9d"
      }
    }
  }
}
